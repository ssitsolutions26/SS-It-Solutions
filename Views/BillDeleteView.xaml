<UserControl x:Class="SolarQuotationBillingSystem.Views.BillDeleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F0F2F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Stats -->
            <RowDefinition Height="Auto"/> <!-- Filters -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Bill Delete Management" FontSize="32" FontWeight="Bold" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,0,20"/>

        <!-- FILTERS -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Background="White" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Bill No / Invoice No" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5,0"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Search" Command="{Binding SearchCommand}" Background="#1976D2" BorderBrush="#1976D2" Margin="5,0"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- DATAGRID -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Background="White" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="12" materialDesign:DataGridAssist.ColumnHeaderPadding="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quotation No" Binding="{Binding QuotationNo}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" IsReadOnly="True" FontWeight="Bold"/>

                        <DataGridTemplateColumn Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- View -->
                                        <Button Content="View" 
                                                Command="{Binding DataContext.PrintBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="30" FontSize="11" Cursor="Hand" Margin="2,0" Background="#1976D2" BorderBrush="#1976D2"/>

                                        <!-- Delete -->
                                        <Button Command="{Binding DataContext.DeleteBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="30" Width="30" Padding="0" Cursor="Hand" Margin="2,0" Background="#D32F2F" BorderBrush="#D32F2F" ToolTip="Delete Bill">
                                            <materialDesign:PackIcon Kind="TrashCan" Foreground="White" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
