<UserControl x:Class="SolarQuotationBillingSystem.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F0F2F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Top Stats -->
            <RowDefinition Height="Auto"/> <!-- Filters -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- TITLE & STATS -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Payment Dashboard" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <materialDesign:Card Background="#2196F3" Foreground="White" Padding="15" Margin="5" UniformCornerRadius="8" Width="180">
                    <StackPanel>
                        <TextBlock Text="Total Bills" FontSize="14" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalBillsCount}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Background="#4CAF50" Foreground="White" Padding="15" Margin="5" UniformCornerRadius="8" Width="180">
                    <StackPanel>
                        <TextBlock Text="Total Received" FontSize="14" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalPaidAmount, StringFormat=₹ {0:N2}}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Background="#F44336" Foreground="White" Padding="15" Margin="5" UniformCornerRadius="8" Width="180">
                    <StackPanel>
                        <TextBlock Text="Total Pending" FontSize="14" Opacity="0.9"/>
                        <TextBlock Text="{Binding TotalPendingAmount, StringFormat=₹ {0:N2}}" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </Grid>

        <!-- FILTERS -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="8" Background="White" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <DatePicker Grid.Column="0" SelectedDate="{Binding FilterDateFrom}" materialDesign:HintAssist.Hint="Date From" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="5,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FilterDateTo}" materialDesign:HintAssist.Hint="Date To" Style="{StaticResource MaterialDesignFloatingHintDatePicker}" Margin="5,0"/>
                
                <TextBox Grid.Column="2" Text="{Binding FilterSearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Search (Customer, Inv No...)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5,0"/>
                
                <ComboBox Grid.Column="3" SelectedItem="{Binding FilterStatus}" ItemsSource="{Binding StatusFilters}" materialDesign:HintAssist.Hint="Status" Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="5,0"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Search" Command="{Binding SearchCommand}" Background="#1976D2" BorderBrush="#1976D2" Margin="5,0"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- DATAGRID -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Background="White" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#D32F2F" Margin="5,0"/>
                    <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#388E3C" Margin="5,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          materialDesign:DataGridAssist.CellPadding="12" materialDesign:DataGridAssist.ColumnHeaderPadding="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat=dd-MMM-yyyy}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Quotation No" Binding="{Binding QuotationNo}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mobile" Binding="{Binding Mobile}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Balance" Binding="{Binding BalanceAmount, StringFormat=₹ {0:N2}}" IsReadOnly="True"/>
                        
                        <DataGridTemplateColumn Header="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PaymentStatus}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding PaymentStatus}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Partial">
                                                            <Setter Property="Foreground" Value="#EF6C00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Pending">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Collect Payment -->
                                        <Button Content="Collect Payment" 
                                                Command="{Binding DataContext.CollectPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="30" FontSize="11" Cursor="Hand" Margin="2,0" Background="#4CAF50" BorderBrush="#4CAF50">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentStatus}" Value="Paid">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Reprint Bill -->
                                        <Button Content="Reprint Bill" 
                                                Command="{Binding DataContext.ReprintBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="30" FontSize="11" Cursor="Hand" Margin="2,0" Background="#0288D1" BorderBrush="#0288D1"/>

                                        <!-- WhatsApp Bill -->
                                        <Button Command="{Binding DataContext.WhatsAppBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="30" Width="30" Padding="0" Cursor="Hand" Margin="2,0" Background="#25D366" BorderBrush="#25D366" ToolTip="Send Bill on WhatsApp">
                                            <materialDesign:PackIcon Kind="Whatsapp" Foreground="White" Width="18" Height="18"/>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionMiniLightButton}">
                                                     <Setter Property="Background" Value="#25D366"/>
                                                     <Setter Property="BorderBrush" Value="#25D366"/>
                                                     <Setter Property="Foreground" Value="White"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
